# ============================================================
#  TOP-бот — конфиг. Скопируйте в .env и впишите токен:
#      cp env.example .env
#      nano .env
#  Файл .env НИКОГДА не коммитьте (он в .gitignore).
# ============================================================

# --- обязательное ------------------------------------------------
# Токен от @BotFather (/newbot). Формат: 123456789:AAH...
BOT_TOKEN=

# --- режим -------------------------------------------------------
# auto | private | business
#   auto     — и обычный ЛС с ботом, и Telegram Business
#   private  — только ЛС с ботом (самый простой вариант)
#   business — только business_message (бот подключён в Telegram Business)
MODE=auto

# --- что и как отправлять ---------------------------------------
TOP_FILE=top.json
TOP_TITLE=ТОП
# Шаблон заголовка (HTML разрешён). {title} и {count} подставляются.
TOP_HEADER=🏆 <b>{title}</b>
# Подпись внизу (можно оставить пустым)
TOP_FOOTER=
# Шаблон строки: {n} — номер, {name} — имя, {score} — очки
ITEM_TEMPLATE={n}. {name}
# Разделитель между строками. Пустая строка между позициями: \n\n
ITEM_SEPARATOR=\n
# Медали для первых трёх мест (🥇🥈🥉)
SHOW_MEDALS=false
# Сколько позиций показывать (0 = все)
TOP_LIMIT=0
# Сортировать по score по убыванию (если score указан)
SORT_BY_SCORE=false
# HTML | none. HTML безопаснее: имена экранируются, эмодзи/жирный работают.
PARSE_MODE=HTML

# --- поведение ---------------------------------------------------
# Команда(ы) через запятую. /top,/toplist — можно несколько.
COMMAND=/top
# Удалять сообщение с командой (как и просили — да)
DELETE_COMMAND=true
# Удалять прошлое сообщение бота перед отправкой нового (false = копятся)
DELETE_PREVIOUS_TOPS=false
# Закреплять свежий топ в ЛС (в бизнес-чатах не поддерживается)
PIN_TOP=false
# Отвечать реплаем на /top (сообщение при этом удаляется)
REPLY_TO_COMMAND=false
# Показывать «печатает…» перед отправкой
SEND_TYPING=false
# Отвечать на /start и /help
SEND_HELP=true
# Прописать /top в меню бота при старте
SET_COMMANDS_MENU=true

# --- антифлуд ----------------------------------------------------
# Минимальный интервал между топами в одном чате, секунд
COOLDOWN_SECONDS=3
# Максимум топов в минуту на чат
MAX_TOPS_PER_MINUTE=6
# Не отвечать на сообщения старше N секунд (0 = отвечать на все)
MAX_MESSAGE_AGE_SECONDS=120

# --- доступ ------------------------------------------------------
# Пусто = всем. ID через запятую.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=
# Кто может /reload
ADMIN_IDS=
# Работать в группах (боту нужно быть админом с правом удалять сообщения)
ALLOW_GROUPS=false

# --- сеть и файлы ------------------------------------------------
# Таймаут long polling, секунд (0–50)
POLL_TIMEOUT=30
STATE_FILE=state.json
LOG_FILE=bot.log
LOG_LEVEL=INFO
# Пропустить накопившиеся апдейты при старте
DROP_PENDING_UPDATES=false
# Снимать webhook при старте (нужно для long polling). Ставьте false только если
# вы действительно держите webhook и запускаете бота в другом режиме.
DELETE_WEBHOOK_ON_START=true
# Ничего не отправлять/удалять, только логировать
DRY_RUN=false
# Только если в Termux не работают сертификаты (НЕ рекомендуется)
INSECURE_TLS=false
# Свой CA-bundle (обычно не нужен)
CA_BUNDLE=
# Свой Bot API server (локальный), обычно не нужен
API_BASE=https://api.telegram.org
