import base64

from base_plugin import BasePlugin
from ui.settings import Header, Switch, Selector
from hook_utils import find_class
from org.telegram.messenger import ApplicationLoader
from dalvik.system import InMemoryDexClassLoader
from java.nio import ByteBuffer

__id__ = "music_island_rework"
__name__ = "Music Island (Rework)"
__description__ = "Floating Apple Dynamic Island style music player overlay."
__author__ = "@musicisland"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"

_DEX_B64 = ""


class MusicIslandReworkPlugin(BasePlugin):
    def on_plugin_load(self):
        self._main = None
        self._class_loader = None
        self._load_dex()
        self._push_config()
        self.run_on_ui_thread(lambda: self._call_rebuild())

    def _load_dex(self):
        if self._main is not None:
            return
        dex_bytes = base64.b64decode(_DEX_B64)
        buf = ByteBuffer.wrap(dex_bytes)
        parent = ApplicationLoader.applicationContext.getClassLoader()
        self._class_loader = InMemoryDexClassLoader(buf, parent)
        self._main = self._class_loader.loadClass("com.musicisland.plugin.Main")
        init = self._main.getMethod("initAndStart")
        init.invoke(None)

    def _push_config(self):
        if self._main is None:
            self._load_dex()
        enabled = self.get_setting("enabled", True)
        show_cover = self.get_setting("show_cover", True)
        show_seek = self.get_setting("show_seek", False)
        show_title = self.get_setting("show_title", False)
        show_author = self.get_setting("show_author", False)
        show_progress = self.get_setting("show_progress", False)
        layout = self.get_setting("buttons_layout", 0)
        size = self.get_setting("size", 0)
        position = self.get_setting("position", 0)
        boolean_type = find_class("boolean")
        if boolean_type is None:
            boolean_class = find_class("java.lang.Boolean")
            if boolean_class is not None:
                try:
                    boolean_type = boolean_class.getField("TYPE").get(None)
                except Exception:
                    boolean_type = None
        if boolean_type is None:
            try:
                from java.lang import Boolean as _JavaBoolean
                boolean_type = _JavaBoolean.TYPE
            except Exception:
                boolean_type = None

        int_type = find_class("int")
        if int_type is None:
            int_class = find_class("java.lang.Integer")
            if int_class is not None:
                try:
                    int_type = int_class.getField("TYPE").get(None)
                except Exception:
                    int_type = None
        if int_type is None:
            try:
                from java.lang import Integer as _JavaInteger
                int_type = _JavaInteger.TYPE
            except Exception:
                int_type = None
        method = self._main.getMethod(
            "setConfig",
            boolean_type,
            boolean_type,
            boolean_type,
            boolean_type,
            boolean_type,
            boolean_type,
            int_type,
            int_type,
            int_type,
        )
        method.invoke(None, enabled, show_cover, show_seek, show_title, show_author, show_progress, layout, size, position)

    def _call_rebuild(self):
        if self._main is None:
            self._load_dex()
        method = self._main.getMethod("rebuildOverlay")
        method.invoke(None)

    def _apply(self):
        self._push_config()
        self.run_on_ui_thread(lambda: self._call_rebuild())

    def _on_change(self, new_value):
        self.run_on_ui_thread(lambda: self._apply())

    def create_settings(self):
        return [
            Header(text="Music Island"),
            Switch(key="enabled", text="Enable overlay", default=True, on_change=self._on_change),
            Switch(key="show_cover", text="Show cover icon", default=True, on_change=self._on_change),
            Switch(key="show_seek", text="Show seek buttons", default=False, on_change=self._on_change),
            Switch(key="show_title", text="Show track title", default=False, on_change=self._on_change),
            Switch(key="show_author", text="Show artist", default=False, on_change=self._on_change),
            Switch(key="show_progress", text="Show progress bar", default=False, on_change=self._on_change),
            Selector(key="buttons_layout", text="Buttons layout", default=0, items=["Horizontal", "Vertical"], on_change=self._on_change),
            Selector(key="size", text="Size", default=0, items=["Compact", "Medium", "Large"], on_change=self._on_change),
            Selector(key="position", text="Position", default=0, items=["Right", "Left"], on_change=self._on_change),
        ]
