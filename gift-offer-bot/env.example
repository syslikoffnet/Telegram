# Gift Offer Bot — настройки.
# Скопируйте в .env (или запустите install-termux.sh) и впишите токен.
# Токен в этой сборке ПУСТОЙ специально: получите свой у @BotFather.
# Вписать безопасно (файл будет с правами 600):
#     python3 bot.py --set-token '123456789:AAH...'

# --- обязательно -----------------------------------------------------------
BOT_TOKEN=

# --- Telegram --------------------------------------------------------------
# Меняйте только если поднимаете локальный Bot API Server / прокси.
API_BASE=https://api.telegram.org

# --- файлы -----------------------------------------------------------------
DB_PATH=offers.db
LOG_FILE=bot.log
LOG_LEVEL=INFO

# --- правила сделки --------------------------------------------------------
# Через сколько часов намерение истекает.
OFFER_TTL_HOURS=24
# Границы цены в звёздах.
MIN_PRICE=1
MAX_PRICE=1000000
# Сколько активных офферов может быть у одного человека.
MAX_OPEN_OFFERS=5
# Пауза между созданиями офферов (антифлуд), секунды.
CREATE_COOLDOWN_SECONDS=20

# --- публичная доска (необязательно) ---------------------------------------
# @username канала или -100... ; бот должен быть админом.
BOARD_CHAT_ID=

# --- поведение -------------------------------------------------------------
# Удалять команды людей (deleteMessage / deleteBusinessMessages).
DELETE_COMMANDS=true
# Обновлять свои карточки при смене статуса.
EDIT_CARDS=true
# Уведомлять стороны об истечении намерения.
NOTIFY_ON_EXPIRE=true
# Long polling timeout, 0..50.
POLL_TIMEOUT=30
# Ничего не отправлять в Telegram, только писать в лог.
DRY_RUN=false

# --- сеть/отладка ----------------------------------------------------------
# НЕ включайте без нужды: отключает проверку TLS.
INSECURE_TLS=false
# Путь к своему CA-бандлу (корпоративный прокси).
CA_BUNDLE=
# Строка поддержки в /help, например @my_support.
SUPPORT_CONTACT=
