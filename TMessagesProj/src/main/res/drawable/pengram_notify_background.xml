    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,1.5 C11.6,5.9 13.1,7.4 17.5,8 C13.1,8.6 11.6,10.1 11,14.5 C10.4,10.1 8.9,8.6 4.5,8 C8.9,7.4 10.4,5.9 11,1.5 Z" />
    <!-- малая искра справа снизу: признак «фон», а не сообщение -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18.2,13.6 C18.5,15.9 19.3,16.7 21.6,17 C19.3,17.3 18.5,18.1 18.2,20.4 C17.9,18.1 17.1,17.3 14.8,17 C17.1,16.7 17.9,15.9 18.2,13.6 Z" />
