uniform shader img;

uniform float radius;
uniform float neutral;
uniform float2 size;
uniform float persp;

// Цилиндрический сгиб строки ленты. Каждый пиксель экрана (fragCoord.y)
// отображается обратно на плоский лист: phi = asin((d - neutral) / radius) —
// угол точки на валике, s = neutral + radius * phi — её исходная координата.
// В точке нейтрали (d == neutral) сгиб отсутствует — сообщение прямое ровно
// там, где пересекает центр экрана; к краям кривизна нарастает плавно и
// монотонно, без «переворота» целиком. Сужение по X (перспективное) имитирует
// уход краёв вглубь. За пределами листа — прозрачность (лист кончился).
half4 main(in float2 fragCoord) {
    float d = fragCoord.y;
    float arg = (d - neutral) / radius;
    arg = clamp(arg, -1.0, 1.0);
    float phi = asin(arg);
    float s = neutral + radius * phi;
    if (s < -1.0 || s > size.y + 1.0) {
        return half4(0.0);
    }
    float c = cos(phi);
    float scale = 1.0 / (1.0 + (1.0 - c) * persp);
    float cx = size.x * 0.5;
    float sx = cx + (fragCoord.x - cx) / scale;
    if (sx < 0.0 || sx > size.x) {
        return half4(0.0);
    }
    return img.eval(float2(sx, s));
}
