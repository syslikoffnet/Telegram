uniform shader img;

uniform float off;
uniform float span;
uniform float kappa;
uniform float2 sigmas;
uniform float2 size;

// Карточка на валике. Края ячейки заданы снаружи (off, span) — швы с соседями
// совпадают точно. Внутри карточки:
//  1) рациональная карта q = t(1+k)/((1+k) - k q) — перспективный наклон:
//     дальняя половина сжимается сильнее, ближняя тянется — читается как
//     УХОД плоскости вглубь, а не схлопывание;
//  2) трапеция по X (sigmas) — дальний край уже, ближний шире: главный
//     визуальный признак «ухода».
// Текст, фото и рамка одного сообщения связаны ОДНОЙ картой — двигаются
// неразрывно, без «уезжания» частей друг от друга.
half4 main(in float2 fragCoord) {
    if (span <= 0.0001) {
        return half4(0.0);
    }
    float q = (fragCoord.y - off) / span;
    if (q < -0.004 || q > 1.004) {
        return half4(0.0);
    }
    float denom = (1.0 + kappa) - kappa * q;
    if (denom <= 0.05) {
        return half4(0.0);
    }
    float t = q / denom;
    float s = t * size.y;
    if (s < -1.0 || s > size.y + 1.0) {
        return half4(0.0);
    }
    float sigma = sigmas.x + (sigmas.y - sigmas.x) * t;
    if (sigma < 0.05) {
        return half4(0.0);
    }
    float cx = size.x * 0.5;
    float sx = cx + (fragCoord.x - cx) / sigma;
    if (sx < 0.0 || sx > size.x) {
        return half4(0.0);
    }
    return img.eval(float2(sx, s));
}
