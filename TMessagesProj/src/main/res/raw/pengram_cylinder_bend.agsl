uniform shader img;

uniform float localT;
uniform float localB;
uniform float roller;
uniform float2 size;

// Два валика — сверху и снизу. Между касательными (localT..localB) полотно
// плоское: пиксель в пиксель, без деформаций. У краёв полотно наматывается
// на валик: экранная точка y берёт угол phi = asin((localT - y) / roller),
// исходная координата s = localT - roller * phi (снизу — симметрично).
// Касательная ставится так (Java: EDGE_K = 0.8), что у самого края экрана
// угол ~53°: ряды НЕ схлопываются в линию (без «переворота»), а гнутся —
// уход читается как сгиб, плюс мягкая перспектива scale = 2 / (2 + 1 - cos).
// Все ячейки считают касательные от ОДНОЙ глобальной геометрии — швы точны.
half4 main(in float2 fragCoord) {
    float y = fragCoord.y;
    float s;
    float sn = 0.0;
    if (y < localT) {
        sn = (localT - y) / roller;
        if (sn > 1.0) {
            return half4(0.0);
        }
        s = localT - roller * asin(sn);
    } else if (y > localB) {
        sn = (y - localB) / roller;
        if (sn > 1.0) {
            return half4(0.0);
        }
        s = localB + roller * asin(sn);
    } else {
        s = y;
    }
    if (s < -1.0 || s > size.y + 1.0) {
        return half4(0.0);
    }
    // мягкая перспектива:2.0 — уход вглубь читается, но без «щелчка» вflip
    float phi = asin(sn);
    float back = 1.0 - cos(phi);
    float scale = 2.0 / (2.0 + back);
    float cx = size.x * 0.5;
    float sx = cx + (fragCoord.x - cx) / scale;
    if (sx < 0.0 || sx > size.x) {
        return half4(0.0);
    }
    return img.eval(float2(sx, s));
}
