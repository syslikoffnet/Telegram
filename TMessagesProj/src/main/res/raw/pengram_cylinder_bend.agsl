uniform shader img;

uniform float off;
uniform float yscale;
uniform float sigma;
uniform float2 size;

// Кусочно-аффинная намотка строки на валик. Глобальная точка листа S
// ложится на окружность: D(S) = axis + R * sin(clamp((S - axis)/R)).
// Внутри ЯЧЕЙКИ отображение заменено точной аффинной интерполяцией по её
// краям (off, yscale), поэтому текст, фото и рамка одного сообщения
// двигаются строго вместе — как жёсткая карточка, без «уезжания» частей
// друг от друга. Края считаются от глобальной окружности, поэтому шов
// соседних строк совпадает точно. sigma — перспективное сужение по X.
half4 main(in float2 fragCoord) {
    if (yscale <= 0.0001) {
        return half4(0.0);
    }
    float s = (fragCoord.y - off) / yscale;
    if (s < -1.0 || s > size.y + 1.0) {
        return half4(0.0);
    }
    float cx = size.x * 0.5;
    float sx = cx + (fragCoord.x - cx) / max(sigma, 0.05);
    if (sx < 0.0 || sx > size.x) {
        return half4(0.0);
    }
    return img.eval(float2(sx, s));
}
